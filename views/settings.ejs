<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('settings.pageTitle') %> — <%= t('common.appName') %></title>
  <%- include('partials/head') %>
</head>
<body class="bg-gradient-to-br from-slate-50 via-white to-blue-50 min-h-screen">

  <nav class="bg-white/80 backdrop-blur border-b border-slate-200 sticky top-0 z-10">
    <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="w-9 h-9 bg-brand-600 rounded-lg flex items-center justify-center text-white">
          <%- include('partials/icon', { name: 'linux', cls: 'w-5 h-5' }) %>
        </a>
        <div>
          <p class="text-sm font-semibold text-slate-900"><%= t('common.appName') %></p>
          <p class="text-xs text-slate-500">UMY</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-sm text-slate-600 hover:text-slate-900 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition-colors flex items-center gap-1.5">
          <%- include('partials/icon', { name: 'arrow-left', cls: 'w-4 h-4' }) %>
          <span class="hidden sm:inline"><%= t('common.backToDashboard') %></span>
        </a>
        <button id="btn-logout" class="text-sm text-slate-600 hover:text-slate-900 border border-slate-300 hover:border-slate-400 rounded-lg px-3.5 py-1.5 transition-colors flex items-center gap-1.5">
          <%- include('partials/icon', { name: 'log-out', cls: 'w-4 h-4' }) %>
          <span class="hidden sm:inline"><%= t('common.logout') %></span>
        </button>
      </div>
    </div>
  </nav>

  <main class="max-w-2xl mx-auto px-4 py-8">

    <div class="mb-6 flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600 shrink-0">
        <%- include('partials/icon', { name: 'settings', cls: 'w-5 h-5' }) %>
      </div>
      <div>
        <h1 class="text-2xl font-semibold text-slate-900"><%= t('settings.title') %></h1>
        <p class="text-sm text-slate-500"><%= t('settings.subtitle') %></p>
      </div>
    </div>

    <!-- ==== Change Password ==== -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8 mb-6">
      <div class="flex items-center gap-2 mb-1">
        <%- include('partials/icon', { name: 'lock', cls: 'w-4 h-4 text-slate-400' }) %>
        <h2 class="text-base font-semibold text-slate-900"><%= t('settings.passwordSectionTitle') %></h2>
      </div>
      <p class="text-xs text-slate-500 mb-5"><%= t('settings.passwordSectionSubtitle') %></p>

      <form id="form-settings-password" autocomplete="on">
        <div class="mb-4">
          <label for="set-old" class="block text-sm font-medium text-slate-700 mb-1.5"><%= t('settings.currentPasswordLabel') %></label>
          <%- include('partials/password-field', { id: 'set-old', name: 'old_password', autocomplete: 'current-password', minlength: null, placeholder: null }) %>
        </div>
        <div class="mb-4">
          <label for="set-new" class="block text-sm font-medium text-slate-700 mb-1.5"><%= t('settings.newPasswordLabel') %></label>
          <%- include('partials/password-field', { id: 'set-new', name: 'new_password', autocomplete: 'new-password', minlength: 8, placeholder: null }) %>
        </div>
        <div class="mb-5">
          <label for="set-confirm" class="block text-sm font-medium text-slate-700 mb-1.5"><%= t('settings.confirmPasswordLabel') %></label>
          <%- include('partials/password-field', { id: 'set-confirm', name: 'confirm_password', autocomplete: 'new-password', minlength: 8, placeholder: null }) %>
        </div>
        <button type="submit" id="btn-update-password"
          class="bg-brand-600 hover:bg-brand-700 text-white font-medium text-sm px-5 py-2.5 rounded-lg transition-all active:scale-[0.98]">
          <%= t('settings.updatePasswordButton') %>
        </button>
      </form>
    </div>

    <!-- ==== Language ==== -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8">
      <div class="flex items-center gap-2 mb-1">
        <%- include('partials/icon', { name: 'globe', cls: 'w-4 h-4 text-slate-400' }) %>
        <h2 class="text-base font-semibold text-slate-900"><%= t('settings.languageSectionTitle') %></h2>
      </div>
      <p class="text-xs text-slate-500 mb-5"><%= t('settings.languageSectionSubtitle') %></p>

      <form id="form-settings-language">
        <div class="flex gap-3 mb-5">
          <label class="flex-1 border border-slate-200 rounded-lg p-3 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 transition-colors flex items-center gap-2">
            <input type="radio" name="lang" value="en" <%= lang === 'en' ? 'checked' : '' %> class="text-brand-600 focus:ring-brand-500">
            <span class="text-sm text-slate-700"><%= t('settings.languageEnglish') %></span>
          </label>
          <label class="flex-1 border border-slate-200 rounded-lg p-3 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 transition-colors flex items-center gap-2">
            <input type="radio" name="lang" value="id" <%= lang === 'id' ? 'checked' : '' %> class="text-brand-600 focus:ring-brand-500">
            <span class="text-sm text-slate-700"><%= t('settings.languageIndonesian') %></span>
          </label>
        </div>
        <button type="submit"
          class="bg-slate-800 hover:bg-slate-900 text-white font-medium text-sm px-5 py-2.5 rounded-lg transition-all active:scale-[0.98]">
          <%= t('settings.saveLanguageButton') %>
        </button>
      </form>
    </div>

  </main>

  <script>
    window.i18n = <%- JSON.stringify({
      updatePasswordButton: t('settings.updatePasswordButton'),
      mismatchError: t('changePassword.mismatchError'),
      passwordUpdateSuccess: t('settings.passwordUpdateSuccess'),
      languageUpdateSuccess: t('settings.languageUpdateSuccess'),
      saveLanguageButton: t('settings.saveLanguageButton')
    }) %>;
  </script>
  <script src="/js/password-toggle.js"></script>
  <script src="/js/notify.js"></script>
  <script src="/js/settings.js"></script>
</body>
</html>
