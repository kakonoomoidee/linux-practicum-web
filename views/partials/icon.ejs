  globe: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"/>',
  // Arrow left (back nav)
  'arrow-left': '<line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>',
  // Activity (uptime/pulse)
  activity: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  // Penguin-ish placeholder (login brand) - pakai terminal style sebagai gantinya karena
  // outline "penguin" custom kurang legible di ukuran kecil; terminal lebih representatif untuk Linux
  linux: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>',
};

const path = icons[name] || icons.box;
%>
<svg class="<%= iconClass %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- path %></svg>
