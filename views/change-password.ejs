<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('changePassword.pageTitle') %> — <%= t('common.appName') %></title>
  <%- include('partials/head') %>
</head>
<body class="bg-gradient-to-br from-slate-50 via-white to-blue-50 min-h-screen flex items-center justify-center p-4">

  <div class="absolute top-4 right-4">
    <%- include('partials/lang-toggle') %>
  </div>

  <div class="w-full max-w-md">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-8">

      <div class="mb-6 text-center">
        <div class="w-12 h-12 bg-amber-500 rounded-xl mx-auto mb-4 flex items-center justify-center text-white">
          <%- include('partials/icon', { name: 'lock', cls: 'w-6 h-6' }) %>
        </div>
        <h1 class="text-xl font-semibold text-slate-900"><%= t('changePassword.title') %></h1>
        <p class="text-sm text-slate-500 mt-1"><%= t('changePassword.subtitle') %></p>
      </div>

      <form id="form-change-password" autocomplete="on">
        <div class="mb-4">
          <label for="cp-old" class="block text-sm font-medium text-slate-700 mb-1.5"><%= t('changePassword.oldPasswordLabel') %></label>
          <%- include('partials/password-field', { id: 'cp-old', name: 'old_password', autocomplete: 'current-password', minlength: null, placeholder: null }) %>
        </div>

        <div class="mb-4">
          <label for="cp-new" class="block text-sm font-medium text-slate-700 mb-1.5"><%= t('changePassword.newPasswordLabel') %></label>
          <%- include('partials/password-field', { id: 'cp-new', name: 'new_password', autocomplete: 'new-password', minlength: 8, placeholder: null }) %>
        </div>

        <div class="mb-5">
          <label for="cp-confirm" class="block text-sm font-medium text-slate-700 mb-1.5"><%= t('changePassword.confirmPasswordLabel') %></label>
          <%- include('partials/password-field', { id: 'cp-confirm', name: 'confirm_password', autocomplete: 'new-password', minlength: 8, placeholder: null }) %>
        </div>

        <button type="submit" id="btn-cp-submit"
          class="w-full bg-brand-600 hover:bg-brand-700 text-white font-medium text-sm py-2.5 rounded-lg transition-all active:scale-[0.98]">
          <%= t('changePassword.submit') %>
        </button>

        <p id="cp-error" class="text-sm text-red-600 mt-3 min-h-[1.25rem]"></p>
      </form>
    </div>
  </div>

  <script>window.i18n = <%- JSON.stringify({ submitting: t('changePassword.submitting'), submit: t('changePassword.submit'), mismatch: t('changePassword.mismatchError') }) %>;</script>
  <script src="/js/csrf.js"></script>
  <script src="/js/password-toggle.js"></script>
  <script src="/js/notify.js"></script>
  <script src="/js/change-password.js"></script>
</body>
</html>
