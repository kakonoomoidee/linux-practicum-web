<!DOCTYPE html>
<html lang="id">
<head>
  <title>Log Server — Praktikum Linux</title>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 min-h-screen">

  <nav class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 bg-slate-800 rounded-lg flex items-center justify-center text-white text-sm">⚙️</div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Admin Panel</p>
          <p class="text-xs text-slate-500">Login sebagai <%= adminUsername %></p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/admin" class="text-sm text-slate-600 hover:text-slate-900">← Dashboard</a>
        <form method="POST" action="/admin/logout">
          <button type="submit" class="text-sm text-slate-600 hover:text-slate-900 border border-slate-300 hover:border-slate-400 rounded-lg px-3.5 py-1.5 transition-colors">
            Logout
          </button>
        </form>
      </div>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-4 py-8">

    <div class="mb-6">
      <h1 class="text-2xl font-semibold text-slate-900">📋 Log Server</h1>
      <p class="text-sm text-slate-500 mt-1">
        <% if (error) { %>
          <span class="text-red-600"><%= error %></span>
        <% } else { %>
          Menampilkan <%= lines.length %> dari <%= totalMatched %> baris yang cocok
          (file: <%= filesRead.join(', ') || '-' %>)
        <% } %>
      </p>
    </div>

    <!-- Filter bar -->
    <form method="GET" action="/admin/logs" class="bg-white border border-slate-200 rounded-xl p-4 mb-6 flex flex-wrap items-end gap-3">
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1">Level</label>
        <select name="level" class="text-sm border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-slate-500">
          <option value="all" <%= filterLevel === 'all' ? 'selected' : '' %>>Semua level</option>
          <option value="error" <%= filterLevel === 'error' ? 'selected' : '' %>>Error saja</option>
          <option value="warn" <%= filterLevel === 'warn' ? 'selected' : '' %>>Warning</option>
          <option value="info" <%= filterLevel === 'info' ? 'selected' : '' %>>Info</option>
          <option value="http" <%= filterLevel === 'http' ? 'selected' : '' %>>HTTP request</option>
          <option value="debug" <%= filterLevel === 'debug' ? 'selected' : '' %>>Debug</option>
        </select>
      </div>

      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-slate-500 mb-1">Cari (NIM, pesan, event, request ID, dst)</label>
        <input type="text" name="q" value="<%= filterSearch %>" placeholder="Contoh: 20220140020 atau container_self_heal"
          class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-slate-500">
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1">Jumlah baris</label>
        <select name="limit" class="text-sm border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-slate-500">
          <option value="100" <%= String(filterLimit) === '100' ? 'selected' : '' %>>100</option>
          <option value="200" <%= String(filterLimit) === '200' ? 'selected' : '' %>>200</option>
          <option value="500" <%= String(filterLimit) === '500' ? 'selected' : '' %>>500</option>
          <option value="1000" <%= String(filterLimit) === '1000' ? 'selected' : '' %>>1000</option>
        </select>
      </div>

      <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
        Terapkan
      </button>
      <a href="/admin/logs" class="text-sm text-slate-500 hover:text-slate-700 px-2 py-2">Reset</a>
    </form>

    <!-- Log entries -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <% if (!error && lines.length === 0) { %>
        <div class="px-6 py-10 text-center text-sm text-slate-400">Tidak ada log yang cocok dengan filter ini.</div>
      <% } else if (!error) { %>
        <div class="divide-y divide-slate-100 max-h-[70vh] overflow-y-auto">
          <% lines.forEach(function(l) { %>
            <%
              const levelStyles = {
                error: 'bg-red-100 text-red-700',
                warn: 'bg-amber-100 text-amber-700',
                info: 'bg-blue-100 text-blue-700',
                http: 'bg-slate-100 text-slate-600',
                debug: 'bg-slate-100 text-slate-400',
              };
              const badgeClass = levelStyles[l.level] || 'bg-slate-100 text-slate-600';
              const meta = Object.assign({}, l);
              delete meta.level; delete meta.message; delete meta.timestamp; delete meta.stack;
              const hasMeta = Object.keys(meta).length > 0;
            %>
            <div class="px-5 py-3 hover:bg-slate-50 font-mono text-xs">
              <div class="flex items-start gap-3">
                <span class="text-slate-400 whitespace-nowrap pt-0.5"><%= new Date(l.timestamp).toLocaleString('id-ID') %></span>
                <span class="badge shrink-0 px-2 py-0.5 rounded-full font-sans font-medium <%= badgeClass %>"><%= l.level %></span>
                <div class="flex-1 min-w-0">
                  <p class="text-slate-800 break-words"><%= l.message %></p>
                  <% if (hasMeta) { %>
                    <p class="text-slate-400 mt-1 break-words"><%= JSON.stringify(meta) %></p>
                  <% } %>
                  <% if (l.stack) { %>
                    <pre class="text-red-500 mt-1 whitespace-pre-wrap break-words"><%= l.stack %></pre>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <p class="text-xs text-slate-400 mt-4">
      Log disimpan di folder <code class="bg-slate-100 px-1.5 py-0.5 rounded"><%= typeof error === 'string' ? '' : '' %>logs/</code>,
      rotasi harian, otomatis dihapus setelah 14 hari. Halaman ini membaca maksimal 3 file terakhir per kategori.
    </p>

  </main>
</body>
</html>
