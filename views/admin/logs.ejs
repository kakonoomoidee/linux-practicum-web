<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('admin.logsPageTitle') %> — <%= t('common.appName') %></title>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 min-h-screen">

  <nav class="bg-white border-b border-slate-200 sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 bg-gradient-to-br from-slate-700 to-slate-900 rounded-lg flex items-center justify-center text-white">
          <%- include('../partials/icon', { name: 'settings', cls: 'w-5 h-5' }) %>
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-900"><%= t('admin.loginTitle') %></p>
          <p class="text-xs text-slate-500"><%= t('admin.loggedInAs') %> <span class="font-medium"><%= adminUsername %></span></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <%- include('../partials/lang-toggle') %>
        <a href="/admin" class="text-sm text-slate-600 hover:text-slate-900 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition-colors flex items-center gap-1.5">
          <%- include('../partials/icon', { name: 'arrow-left', cls: 'w-4 h-4' }) %>
          <span class="hidden sm:inline"><%= t('admin.navDashboard') %></span>
        </a>
        <button id="btn-admin-logout" class="text-sm text-slate-600 hover:text-slate-900 border border-slate-300 hover:border-slate-400 rounded-lg px-3.5 py-1.5 transition-colors flex items-center gap-1.5">
          <%- include('../partials/icon', { name: 'log-out', cls: 'w-4 h-4' }) %>
          <span class="hidden sm:inline"><%= t('common.logout') %></span>
        </button>
      </div>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-4 py-8">

    <div class="mb-6 flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600 shrink-0">
        <%- include('../partials/icon', { name: 'clipboard-list', cls: 'w-5 h-5' }) %>
      </div>
      <div>
        <h1 class="text-2xl font-semibold text-slate-900"><%= t('admin.logsTitle') %></h1>
        <p class="text-sm text-slate-500">
          <% if (error) { %>
            <span class="text-red-600"><%= error %></span>
          <% } else { %>
            <%= t('admin.logsShowing', { shown: lines.length, total: totalMatched, files: filesRead.join(', ') || '-' }) %>
          <% } %>
        </p>
      </div>
    </div>

    <!-- Filter bar -->
    <form method="GET" action="/admin/logs" class="bg-white border border-slate-200 rounded-xl p-4 mb-6 flex flex-wrap items-end gap-3">
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1"><%= t('admin.logsLevelLabel') %></label>
        <select name="level" class="text-sm border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-slate-500">
          <option value="all" <%= filterLevel === 'all' ? 'selected' : '' %>><%= t('admin.logsAllLevels') %></option>
          <option value="error" <%= filterLevel === 'error' ? 'selected' : '' %>><%= t('admin.logsErrorOnly') %></option>
          <option value="warn" <%= filterLevel === 'warn' ? 'selected' : '' %>><%= t('admin.logsWarnOnly') %></option>
          <option value="info" <%= filterLevel === 'info' ? 'selected' : '' %>><%= t('admin.logsInfoOnly') %></option>
          <option value="http" <%= filterLevel === 'http' ? 'selected' : '' %>><%= t('admin.logsHttpOnly') %></option>
          <option value="debug" <%= filterLevel === 'debug' ? 'selected' : '' %>><%= t('admin.logsDebugOnly') %></option>
        </select>
      </div>

      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-slate-500 mb-1"><%= t('admin.logsSearchLabel') %></label>
        <input type="text" name="q" value="<%= filterSearch %>" placeholder="<%= t('admin.logsSearchPlaceholder') %>"
          class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-slate-500">
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1"><%= t('admin.logsLimitLabel') %></label>
        <select name="limit" class="text-sm border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-slate-500">
          <option value="100" <%= String(filterLimit) === '100' ? 'selected' : '' %>>100</option>
          <option value="200" <%= String(filterLimit) === '200' ? 'selected' : '' %>>200</option>
          <option value="500" <%= String(filterLimit) === '500' ? 'selected' : '' %>>500</option>
          <option value="1000" <%= String(filterLimit) === '1000' ? 'selected' : '' %>>1000</option>
        </select>
      </div>

      <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
        <%= t('admin.logsApplyButton') %>
      </button>
      <a href="/admin/logs" class="text-sm text-slate-500 hover:text-slate-700 px-2 py-2"><%= t('admin.logsResetButton') %></a>
    </form>

    <!-- Log entries -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <% if (!error && lines.length === 0) { %>
        <div class="px-6 py-10 text-center text-sm text-slate-400"><%= t('admin.logsNoMatch') %></div>
      <% } else if (!error) { %>
        <div class="divide-y divide-slate-100 max-h-[70vh] overflow-y-auto">
          <% lines.forEach(function(l) { %>
            <%
              const levelStyles = {
                error: 'bg-red-100 text-red-700',
                warn: 'bg-amber-100 text-amber-700',
                info: 'bg-blue-100 text-blue-700',
                http: 'bg-slate-100 text-slate-600',
                debug: 'bg-slate-100 text-slate-400',
              };
              const badgeClass = levelStyles[l.level] || 'bg-slate-100 text-slate-600';
              const meta = Object.assign({}, l);
              delete meta.level; delete meta.message; delete meta.timestamp; delete meta.stack;
              const hasMeta = Object.keys(meta).length > 0;
              const dateLocale = lang === 'id' ? 'id-ID' : 'en-US';
            %>
            <div class="px-5 py-3 hover:bg-slate-50 font-mono text-xs">
              <div class="flex items-start gap-3">
                <span class="text-slate-400 whitespace-nowrap pt-0.5"><%= new Date(l.timestamp).toLocaleString(dateLocale) %></span>
                <span class="badge shrink-0 px-2 py-0.5 rounded-full font-sans font-medium <%= badgeClass %>"><%= l.level %></span>
                <div class="flex-1 min-w-0">
                  <p class="text-slate-800 break-words"><%= l.message %></p>
                  <% if (hasMeta) { %>
                    <p class="text-slate-400 mt-1 break-words"><%= JSON.stringify(meta) %></p>
                  <% } %>
                  <% if (l.stack) { %>
                    <pre class="text-red-500 mt-1 whitespace-pre-wrap break-words"><%= l.stack %></pre>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <p class="text-xs text-slate-400 mt-4"><%= t('admin.logsFolderNote') %></p>

  </main>

  <script src="/js/notify.js"></script>
  <script>
    document.getElementById('btn-admin-logout').addEventListener('click', async () => {
      await fetch('/admin/logout', { method: 'POST', credentials: 'same-origin' });
      window.location.href = '/admin/login';
    });
  </script>
</body>
</html>
