<!DOCTYPE html>
<html lang="id">
<head>
  <title>Admin Dashboard — Praktikum Linux</title>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 min-h-screen">

  <nav class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 bg-slate-800 rounded-lg flex items-center justify-center text-white text-sm">⚙️</div>
        <div>
          <p class="text-sm font-semibold text-slate-900">Admin Panel</p>
          <p class="text-xs text-slate-500">Login sebagai <%= adminUsername %></p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/admin/logs" class="text-sm text-slate-600 hover:text-slate-900">📋 Log Server</a>
        <form method="POST" action="/admin/logout">
          <button type="submit" class="text-sm text-slate-600 hover:text-slate-900 border border-slate-300 hover:border-slate-400 rounded-lg px-3.5 py-1.5 transition-colors">
            Logout
          </button>
        </form>
      </div>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-4 py-8">

    <% if (notice) { %>
      <div class="bg-blue-50 border border-blue-100 text-blue-700 text-sm rounded-lg px-4 py-3 mb-6">
        <%= notice %>
      </div>
    <% } %>

    <!-- ==== Summary cards ==== -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="bg-white border border-slate-200 rounded-xl p-4">
        <p class="text-xs text-slate-500 mb-1">Total Mahasiswa</p>
        <p class="text-2xl font-semibold text-slate-900"><%= summary.total_students %></p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-4">
        <p class="text-xs text-slate-500 mb-1">Instance Aktif</p>
        <p class="text-2xl font-semibold text-brand-600"><%= summary.active_containers %></p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-4">
        <p class="text-xs text-slate-500 mb-1">Total Dibuat (sepanjang waktu)</p>
        <p class="text-2xl font-semibold text-slate-900"><%= summary.total_containers_ever %></p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-4">
        <p class="text-xs text-slate-500 mb-1">Login 24 jam terakhir</p>
        <p class="text-2xl font-semibold text-slate-900"><%= summary.logins_last_24h %></p>
      </div>
    </div>

    <!-- ==== Running instances ==== -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm mb-8 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-base font-semibold text-slate-900">📦 Instance yang Sedang Jalan</h2>
        <p class="text-xs text-slate-500 mt-0.5">Total <%= runningInstances.length %> instance aktif</p>
      </div>

      <% if (runningInstances.length === 0) { %>
        <div class="px-6 py-10 text-center text-sm text-slate-400">Belum ada instance yang jalan.</div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-left text-xs text-slate-500">
                <th class="px-6 py-3 font-medium">NIM</th>
                <th class="px-6 py-3 font-medium">Nama</th>
                <th class="px-6 py-3 font-medium">Container</th>
                <th class="px-6 py-3 font-medium">SSH</th>
                <th class="px-6 py-3 font-medium">Dibuat</th>
                <th class="px-6 py-3 font-medium">Expired</th>
                <th class="px-6 py-3 font-medium"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% runningInstances.forEach(function(inst) { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-3 text-slate-900 font-medium"><%= inst.nim %></td>
                  <td class="px-6 py-3 text-slate-700"><%= inst.nama %></td>
                  <td class="px-6 py-3 text-slate-500 text-xs"><%= inst.container_name %></td>
                  <td class="px-6 py-3">
                    <code class="bg-slate-900 text-green-400 px-2 py-1 rounded text-xs"><%= inst.ssh_command %></code>
                  </td>
                  <td class="px-6 py-3 text-slate-500 text-xs whitespace-nowrap">
                    <%= new Date(inst.created_at).toLocaleString('id-ID') %>
                  </td>
                  <td class="px-6 py-3 text-slate-500 text-xs whitespace-nowrap">
                    <%= new Date(inst.expires_at).toLocaleString('id-ID') %>
                  </td>
                  <td class="px-6 py-3">
                    <form method="POST" action="/admin/instances/<%= inst.id %>/destroy"
                          onsubmit="return confirm('Hapus paksa instance milik <%= inst.nim %>?');">
                      <button type="submit" class="text-xs text-red-600 hover:text-white hover:bg-red-600 border border-red-200 hover:border-red-600 rounded-lg px-3 py-1.5 transition-colors whitespace-nowrap">
                        Hapus
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- ==== Usage stats per mahasiswa ==== -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-base font-semibold text-slate-900">📊 Statistik Pemakaian per Mahasiswa</h2>
        <p class="text-xs text-slate-500 mt-0.5">Diurutkan dari yang paling sering pakai</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-left text-xs text-slate-500">
              <th class="px-6 py-3 font-medium">NIM</th>
              <th class="px-6 py-3 font-medium">Nama</th>
              <th class="px-6 py-3 font-medium text-center">Total Login</th>
              <th class="px-6 py-3 font-medium text-center">Total Container Dibuat</th>
              <th class="px-6 py-3 font-medium text-center">Sedang Aktif</th>
              <th class="px-6 py-3 font-medium">Terakhir Bikin Container</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% usageStats.forEach(function(u) { %>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-3 text-slate-900 font-medium"><%= u.nim %></td>
                <td class="px-6 py-3 text-slate-700"><%= u.nama %></td>
                <td class="px-6 py-3 text-center text-slate-700"><%= u.login_count %></td>
                <td class="px-6 py-3 text-center text-slate-700"><%= u.total_containers %></td>
                <td class="px-6 py-3 text-center">
                  <% if (u.active_containers > 0) { %>
                    <span class="text-xs font-medium bg-green-100 text-green-700 px-2 py-1 rounded-full">Aktif</span>
                  <% } else { %>
                    <span class="text-xs font-medium bg-slate-100 text-slate-500 px-2 py-1 rounded-full">Tidak</span>
                  <% } %>
                </td>
                <td class="px-6 py-3 text-slate-500 text-xs whitespace-nowrap">
                  <%= u.last_container_at ? new Date(u.last_container_at).toLocaleString('id-ID') : '—' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</body>
</html>
