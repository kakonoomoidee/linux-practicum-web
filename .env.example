# =============================================================================
# File ini dipakai di 2 mode:
#
# 1) DOCKER COMPOSE (direkomendasikan, paling gampang diatur):
#    Copy jadi ".env" di root project. docker-compose.yml otomatis baca variabel
#    di bawah ini (PGUSER, PGPASSWORD, dst) buat setup service "db" dan
#    menyusun DATABASE_URL secara otomatis untuk service "app". Kamu TIDAK perlu
#    isi DATABASE_URL manual di mode ini.
#
# 2) NODE LANGSUNG (npm start, tanpa Docker):
#    Copy jadi ".env" juga, tapi kamu WAJIB isi DATABASE_URL manual mengarah ke
#    PostgreSQL yang kamu jalankan sendiri di host (lihat baris DATABASE_URL).
# =============================================================================

# === Server ===
PORT=3000
APP_PORT=3000
SESSION_SECRET=ganti_ini_dengan_random_string_yang_panjang_dan_rahasia
NODE_ENV=production

# === PostgreSQL ===
# Dipakai Docker Compose buat bikin user/db PostgreSQL di service "db":
PGUSER=praktikum_user
PGPASSWORD=ganti_password_ini
PGDATABASE=praktikum_db

# HANYA diisi/dipakai kalau jalanin "node server.js" LANGSUNG (bukan lewat Docker Compose).
# Kalau pakai Docker Compose, baris ini diabaikan (compose yang nyusun otomatis, host-nya "db").
DATABASE_URL=postgres://praktikum_user:ganti_password_ini@localhost:5432/praktikum_db

# === Docker (buat provisioning container mahasiswa) ===
DOCKER_SOCKET=/var/run/docker.sock
STUDENT_IMAGE=praktikum-linux:latest
DOCKER_NETWORK=student-net

# Catatan: WSL_DISTRO_NAME TIDAK perlu diisi manual - itu otomatis ada di environment
# variable shell WSL kamu, dan Docker Compose otomatis meneruskannya ke container app
# (dipakai buat auto-detect host, lihat penjelasan SSH_HOST_DISPLAY di bawah).

# Host/IP yang ditampilkan ke mahasiswa buat SSH.
#
# BIARKAN KOSONG buat AUTO-DETECT (direkomendasikan):
# - Kalau kedeteksi jalan di WSL -> otomatis pakai "localhost" (WSL2 auto-forward port ke Windows)
# - Kalau di server Linux beneran -> otomatis scan network interface, ambil IP LAN yang paling masuk akal
#
# Isi manual di sini HANYA kalau auto-detect salah pilih interface (server dengan banyak NIC)
# atau kamu pakai Docker Desktop di Windows/Mac (network_mode: host kurang reliable di sana).
# Nilai di sini SELALU menang dibanding hasil auto-detect.
SSH_HOST_DISPLAY=

# Range port yang dipakai untuk mapping SSH tiap container mahasiswa (internal only)
SSH_PORT_MIN=30000
SSH_PORT_MAX=40000

# === Container policy ===
CONTAINER_TTL_HOURS=24
CONTAINER_MEMORY_MB=512
CONTAINER_CPU_LIMIT=0.5
CONTAINER_DISK_QUOTA_MB=2048
MAX_CONTAINER_PER_STUDENT=1

# Default password untuk akun baru sebelum mahasiswa ganti sendiri
DEFAULT_STUDENT_PASSWORD=12345678

# Cron: interval pengecekan container expired (menit)
CLEANUP_CRON_PATTERN=*/10 * * * *

# === Admin ===
ADMIN_USERNAME=admin
# Kalau dikosongin, script seed bakal generate password random & ditampilkan SEKALI saat seed dijalankan
ADMIN_PASSWORD=
