# =============================================================================
# Copy file ini jadi ".env" di root project sebelum jalanin "docker compose up".
#
# docker-compose.yml otomatis baca variabel di bawah ini (PGUSER, PGPASSWORD, dst)
# buat setup service "db" dan menyusun DATABASE_URL secara otomatis untuk service
# "app". Kamu TIDAK perlu isi DATABASE_URL manual.
#
# (Baris DATABASE_URL di bawah cuma dipakai kalau kamu jalanin "node server.js"
# langsung tanpa Docker buat keperluan development - di luar cakupan README utama.)
# =============================================================================

# === Server ===
PORT=3000
APP_PORT=3000
SESSION_SECRET=ganti_ini_dengan_random_string_yang_panjang_dan_rahasia
NODE_ENV=production

# Isi dengan jumlah reverse proxy (nginx, dll) yang beneran ada di depan app,
# supaya rate-limiting & logging IP mahasiswa akurat (baca IP asli dari
# X-Forwarded-For, bukan IP proxy-nya). BIARKAN 0 kalau app diakses langsung
# tanpa reverse proxy (default paling aman, cocok buat setup awal).
TRUST_PROXY_HOPS=0

# === PostgreSQL ===
# Dipakai Docker Compose buat bikin user/db PostgreSQL di service "db":
PGUSER=praktikum_user
PGPASSWORD=ganti_password_ini
PGDATABASE=praktikum_db

# Image PostgreSQL yang dipakai. Biasanya ga perlu diubah.
POSTGRES_IMAGE=postgres:16-alpine

# Port di sisi HOST yang di-mapping ke PostgreSQL di dalam container (cuma bisa
# diakses dari mesin/VM yang sama, TIDAK reachable dari LAN - lihat komentar di
# docker-compose.yml). Default SENGAJA bukan 5432 (port standar PostgreSQL),
# karena banyak yang sudah punya PostgreSQL service sendiri jalan di situ -
# kalau dipaksa sama, Docker Compose bakal gagal start dengan error
# "port is already allocated". Ganti kalau 5433 juga kebetulan kepakai.
DB_HOST_PORT=5433

# Diabaikan sepenuhnya kalau pakai Docker Compose (compose yang nyusun otomatis
# dari variabel PGUSER/PGPASSWORD/PGDATABASE/DB_HOST_PORT di atas). Cuma relevan
# kalau jalanin "node server.js" langsung tanpa Docker.
DATABASE_URL=postgres://praktikum_user:ganti_password_ini@localhost:5432/praktikum_db

# === Docker (buat provisioning container mahasiswa) ===
DOCKER_SOCKET=/var/run/docker.sock
STUDENT_IMAGE=praktikum-linux:latest
DOCKER_NETWORK=student-net

# Path Docker socket di sisi HOST. Biasanya ga perlu diubah - cuma relevan kalau
# kamu pakai rootless Docker yang socket-nya bukan di lokasi standar.
DOCKER_SOCKET_HOST=/var/run/docker.sock

# Catatan: WSL_DISTRO_NAME TIDAK perlu diisi manual - itu otomatis ada di environment
# variable shell WSL kamu, dan Docker Compose otomatis meneruskannya ke container app
# (dipakai buat auto-detect host, lihat penjelasan SSH_HOST_DISPLAY di bawah).

# Host/IP yang ditampilkan ke mahasiswa buat SSH.
#
# BIARKAN KOSONG buat AUTO-DETECT (direkomendasikan):
# - Kalau kedeteksi jalan di WSL -> otomatis pakai "localhost" (WSL2 auto-forward port ke Windows)
# - Kalau di server Linux beneran -> otomatis scan network interface, ambil IP LAN yang paling masuk akal
#
# Isi manual di sini HANYA kalau auto-detect salah pilih interface (server dengan banyak NIC)
# atau kamu pakai Docker Desktop di Windows/Mac (network_mode: host kurang reliable di sana).
# Nilai di sini SELALU menang dibanding hasil auto-detect.
SSH_HOST_DISPLAY=

# Range port yang dipakai untuk mapping SSH tiap container mahasiswa (internal only)
SSH_PORT_MIN=30000
SSH_PORT_MAX=40000

# === Container policy ===
CONTAINER_TTL_HOURS=24
CONTAINER_MEMORY_MB=512
CONTAINER_CPU_LIMIT=0.5
CONTAINER_DISK_QUOTA_MB=2048
MAX_CONTAINER_PER_STUDENT=1

# Default password untuk akun baru sebelum mahasiswa ganti sendiri
DEFAULT_STUDENT_PASSWORD=12345678

# Cron: interval pengecekan container expired (menit)
CLEANUP_CRON_PATTERN=*/10 * * * *

# === Logging ===
# Level minimum yang di-log: error, warn, info, http, debug (dari paling penting ke paling detail)
# Default: "info" kalau NODE_ENV=production, "debug" kalau bukan. Biasanya ga perlu diisi manual.
LOG_LEVEL=
# Folder buat nyimpen file log (rotasi harian, otomatis dihapus setelah 14 hari).
# Default: folder "logs/" di root project. Biasanya ga perlu diisi manual.
LOG_DIR=
# Khusus Docker Compose: lokasi folder log di sisi HOST (bukan di dalam container).
# Berguna kalau mau simpan log di disk/partition terpisah. Biasanya ga perlu diubah.
LOG_DIR_HOST=./logs

# === Admin ===
ADMIN_USERNAME=admin
# Kalau dikosongin, script seed bakal generate password random & ditampilkan SEKALI saat seed dijalankan
ADMIN_PASSWORD=
